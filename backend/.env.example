# Application
APP_ENV=development
APP_NAME=SupplierShield
APP_URL=http://localhost:5173
API_URL=http://localhost:8000

# Data: leave Supabase values empty for local demo mode. Use only server-side values here.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY is accepted as a legacy alias.
SUPABASE_DB_URL=
DATABASE_URL=sqlite:///./suppliershield.db

# Optional AI analyst (core assessments work without it)
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional Razorpay Test/Sandbox integration only
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Storage
SUPABASE_STORAGE_BUCKET=supplier-documents

# Security and CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEMO_MODE=true

# Application limits
MAX_UPLOAD_SIZE_MB=10
MAX_AI_REQUESTS_PER_MINUTE=10
MAX_ASSESSMENTS_PER_MINUTE=10

# Versioning
MODEL_VERSION=supplier-risk-v1
RULESET_VERSION=rules-v1
PROMPT_VERSION=prompt-v1
